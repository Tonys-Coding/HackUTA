# --- Models ---
# Voice pipeline: ElevenLabs STT + Gemini LLM + ElevenLabs TTS
ELEVEN_API_KEY=YOUR_ELEVEN_API_KEY
# Gemini: LLM + vision + embeddings (also used as GOOGLE_API_KEY by LiveKit Google plugin)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional (not required for current voice path)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?appName=sightline
MONGODB_DB=sightline

# --- Local server ---
