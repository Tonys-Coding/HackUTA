# Fill these in privately. All three LiveKit values must belong to one project.
# On a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Required for ElevenLabs STT + TTS pipeline
ELEVEN_API_KEY=YOUR_ELEVEN_API_KEY
# Optional: ELEVEN_TTS_MODEL=eleven_flash_v2_5
# Optional: ELEVEN_VOICE_ID=

# Phase 1+ vision / embeddings.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY
# Optional model overrides:
# GEMINI_VISION_MODEL=gemini-3.6-flash
# GEMINI_LLM_MODEL=gemini-3.5-flash-lite

# Optional fallback / other tools
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Must match what the agent registers with. chert dev / doctor read this.
AGENT_NAME=argo

# Shared-trial iMessage (Gary / Chert): project API key — NOT a messaging signing_secret.
# POST https://app.trychert.com/api/v1/shared-messages with Idempotency-Key header.
# Body: { line_id, recipient, text }. PNG attachments may be disabled on shared lines.
CHERT_API_KEY=YOUR_CHERT_PROJECT_API_KEY
CHERT_PROJECT_ID=YOUR_CHERT_PROJECT_ID
CHERT_LINE_ID=YOUR_SHARED_LINE_ID
CHERT_IMESSAGE_TO=+1XXXXXXXXXX
# Optional: CHERT_API_BASE=https://app.trychert.com
# Dedicated Messaging tenant only:
# CHERT_SIGNING_SECRET=YOUR_CHERT_SIGNING_SECRET
# Optional theme: white-on-black | yellow-on-black | black-on-white
# MAGNIFIER_THEME=white-on-black

# Local Express API for event logging / dashboard (Phase 1+).
SIGHTLINE_API_URL=http://localhost:8787
