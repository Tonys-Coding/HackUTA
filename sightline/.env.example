# Fill these in privately. Prefer leaving LiveKit blank on the free trial so
# `chert dev` uses Chert rooms (no LiveKit account needed). If you use your own
# LiveKit project, all three values must belong to that same project.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice pipeline: ElevenLabs STT + Gemini LLM + ElevenLabs TTS
ELEVEN_API_KEY=YOUR_ELEVEN_API_KEY
# Optional: pick a voice at https://elevenlabs.io/app/voice-library
# ELEVEN_VOICE_ID=bIHbv24MWmeRgasZH58o
# Cost-efficient TTS (default): eleven_flash_v2_5
# ELEVEN_TTS_MODEL=eleven_flash_v2_5

# Gemini LLM (+ vision). Also copied as GOOGLE_API_KEY for the LiveKit plugin.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY
# Defaults: vision=gemini-3.6-flash, chat=gemini-3.5-flash-lite
# GEMINI_VISION_MODEL=gemini-3.6-flash
# GEMINI_LLM_MODEL=gemini-3.5-flash-lite

# Magnifier (large text on outbound FaceTime video)
# MAGNIFIER_THEME=white-on-black
# MAGNIFIER_MS=22000

# Optional fallback / other tools
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Must match what the agent registers with. chert dev / doctor read this.
AGENT_NAME=argo

# Local Express API for event logging / dashboard (Phase 1+).
SIGHTLINE_API_URL=http://localhost:8787
